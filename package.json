{
  "name": "md2pub",
  "type": "module",
  "version": "2.1.0",
  "private": false,
  "description": "md2pub - Markdown to Publishing | 一款高度简洁的 Markdown 编辑器：支持多样化主题、本地博客管理、自定义样式、多图床、AI 助手等特性",
  "homepage": "https://github.com/Algieba-dean/md2pub",
  "repository": {
    "type": "git",
    "url": "https://github.com/Algieba-dean/md2pub"
  },
  "bugs": {
    "url": "https://github.com/Algieba-dean/md2pub/issues"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "pnpm web dev",
    "web": "pnpm --filter @md/web",
    "vscode": "pnpm --prefix ./apps/vscode",
    "cli": "pnpm --filter @doocs/md-cli",
    "build:cli": "pnpm web build && npx shx rm -rf packages/md-cli/dist && npx shx rm -rf dist/**/*.map && npx shx cp -r apps/web/dist packages/md-cli/ && cd packages/md-cli && npm pack",
    "release:cli": "node ./scripts/release.js",
    "lint": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "vue-tsc --build --force",
    "postinstall": "simple-git-hooks",
    "inspector": "pnpx node-modules-inspector",
    "utools:package": "node ./scripts/package-utools.mjs"
  },
  "dependencies": {
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "6.39.11"
  },
  "devDependencies": {
    "@antfu/eslint-config": "7.2.0",
    "@vitest/coverage-v8": "^3.1.0",
    "vitest": "^3.1.0",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^25.0.10",
    "archiver": "^7.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.3.1",
    "npm-run-all": "^4.1.5",
    "prettier": "2.8.8",
    "shx": "^0.4.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
